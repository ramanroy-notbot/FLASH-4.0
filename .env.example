# VITE_GEMINI_API_KEY: Required for client-side Gemini AI API calls on Vercel / static hosts.
# Set this in your Vercel Environment Variables or local .env file.
VITE_GEMINI_API_KEY=""

# GEMINI_API_KEY: Fallback for AI Studio runtime environment.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
